{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "GitCraft",
  "version": "0.1.0",
  "identifier": "dev.gitcraft.desktop",
  "build": {
    "frontendDist": "ui/dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "GitCraft",
        "width": 930,
        "height": 669,
        "minWidth": 760,
        "minHeight": 520,
        "decorations": false,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.png", "icons/icon.ico"]
  }
}
