{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "GitCraft",
  "version": "0.1.0",
  "identifier": "dev.gitcraft.desktop",
  "build": {
    "frontendDist": "ui/dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "GitCraft",
        "width": 930,
        "height": 669,
        "minWidth": 760,
        "minHeight": 520,
        "decorations": false,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "msi",
      "deb",
      "appimage",
      "rpm",
      "dmg",
      "app"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "category": "DeveloperTool",
    "shortDescription": "A graphical Git client",
    "longDescription": "GitCraft is a desktop Git client with a commit graph, staging, interactive rebase, a merge tool, GitHub and GitLab pull requests, and AI helpers.",
    "license": "GPL-3.0-only",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": false
      },
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      }
    },
    "linux": {
      "deb": {
        "depends": [
          "git"
        ]
      },
      "rpm": {
        "depends": [
          "git"
        ]
      }
    }
  }
}
